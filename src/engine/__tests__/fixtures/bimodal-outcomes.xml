  <pool id="2" x="220" y="240" color="#3366CC" number="0" max="1" text="Tray"/>
  <gate id="3" x="360" y="240" color="#3366CC" activation="automatic" pullMode="pull all" gateType="dice"/>
  <pool id="4" x="500" y="120" color="#22AA55" number="0" max="1" text="Fast Mode"/>
  <pool id="5" x="500" y="360" color="#CC4444" number="0" max="1" text="Slow Mode"/>
