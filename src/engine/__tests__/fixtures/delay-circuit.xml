<?xml version="1.0" encoding="UTF-8"?>
<diagram>
  <!-- Source produces 10 per tick -->
  <source id="1" x="0" y="0" color="#FF0000" activation="automatic"/>
  <!-- Delay element - holds resources for 3 ticks -->
  <delay id="2" x="200" y="0" color="#FF0000" actions="3"/>
  <!-- Pool collects delayed output -->
  <pool id="3" x="400" y="0" color="#FF0000" number="0" max="200"/>
  <!-- Source to Delay -->
  <resourceConnection id="4" from="1" to="2" startX="0" startY="0" endX="200" endY="0" text="10" color="#FF0000" labelPosition="0.5"/>
  <!-- Delay to Pool -->
  <resourceConnection id="5" from="2" to="3" startX="200" startY="0" endX="400" endY="0" text="all" color="#FF0000" labelPosition="0.5"/>
</diagram>
