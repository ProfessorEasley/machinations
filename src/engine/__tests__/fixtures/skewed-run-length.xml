<?xml version="1.0" encoding="UTF-8"?>
<!--
  Skewed run length: the same shape as `probabilistic-race.xml` — a Source
  feeds a Feeder pool and an automatic "pull all" dice Gate routes each unit
  50/50 into "Heads" or "Tails" — but racing to 60 instead of 5.

  The long race is the point. Run length is how many trials it takes either
  side to reach 60, which is right-skewed with a long upper tail: most runs
  finish in a narrow band and an occasional unlucky one drags on well past it.
  Every run completes, so the durations are measurements rather than censored
  observations.

  That combination is what this fixture exists for. Every other fixture is
  either deterministic — zero IQR, so no outlier can exist by definition — or
  has no End Condition, so every run is censored and there are no completed
  durations to judge at all. Neither can exercise the batch report's outlier
  path. A single 50% branch will not do either: the engine dispatches that as
  fractional flow, which is deterministic. Two competing branches are what make
  the gate's routing actually random.
-->
<diagram>
  <source id="1" x="120" y="160" color="#3366CC" activation="automatic" text="Coin"/>
  <pool id="2" x="300" y="160" color="#3366CC" number="0" max="1000" text="Feeder"/>
  <gate id="3" x="480" y="160" color="#3366CC" activation="automatic" pullMode="pull all" gateType="dice"/>

  <pool id="6" x="680" y="80" color="#22AA55" number="0" max="1000" text="Heads"/>
  <pool id="7" x="680" y="240" color="#CC4444" number="0" max="1000" text="Tails"/>

  <endCondition id="8" x="900" y="80" color="#000000" text="Heads Win"/>
  <endCondition id="9" x="900" y="240" color="#000000" text="Tails Win"/>

  <resourceConnection id="10" from="1" to="2"
    startX="120" startY="160" endX="300" endY="160"
    text="1" color="#3366CC" labelPosition="0.5"/>
  <resourceConnection id="11" from="2" to="3"
    startX="300" startY="160" endX="480" endY="160"
    text="all" color="#3366CC" labelPosition="0.5"/>

  <resourceConnection id="12" from="3" to="6"
    startX="480" startY="160" endX="680" endY="80"
    text="50%" color="#22AA55" labelPosition="0.5"/>
  <resourceConnection id="13" from="3" to="7"
    startX="480" startY="160" endX="680" endY="240"
    text="50%" color="#CC4444" labelPosition="0.5"/>

  <stateConnection id="14" from="6" to="8"
    startX="680" startY="80" endX="900" endY="80"
    text="&gt;= 60" color="#000000" labelPosition="0.5"/>
  <stateConnection id="15" from="7" to="9"
    startX="680" startY="240" endX="900" endY="240"
    text="&gt;= 60" color="#000000" labelPosition="0.5"/>
</diagram>
